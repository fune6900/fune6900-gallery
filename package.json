{
  "name": "fune-gallery-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "css": "sass styles/scss/main.scss app/fune-gallery.css --load-path=node_modules --style=expanded --no-source-map",
    "css:watch": "sass --watch styles/scss/main.scss app/fune-gallery.css --load-path=node_modules --style=expanded --no-source-map",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "tsx scripts/migrate-local.ts",
    "backfill:size": "tsx scripts/backfill-image-size.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "next": "15.1.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "bootstrap": "^5.3.8",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "mysql2": "^3.12.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
