# =============================================================
#  環境変数の雛形。値は書かない（security.md）。
#
#  ローカル開発:
#    このファイルを .env.local にコピーして値を入れる。
#    Workers のローカル実行（npm run preview）では、下の
#    「ランタイム」側を .dev.vars にも書く必要がある。
#
#  本番（Cloudflare Workers）:
#    ビルド時 … NEXT_PUBLIC_* はバンドルに焼き込まれるので、
#               `npm run deploy` を走らせる環境に置く（CI の env / Secrets）。
#    ランタイム … wrangler secret put <名前> で登録する。
# =============================================================

# --- ビルド時に要る（NEXT_PUBLIC_ はブラウザに配られる）---

# Supabase。anon キーは公開前提。保護は RLS で行う
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サイトの絶対URL。例: https://gallery.example.com
#
# ★Cloudflare では必ず設定する。
#  Vercel は VERCEL_URL を自動で入れてくれたが Cloudflare には無い。
#  未設定だと lib/site.ts が localhost に落ち、robots.txt / sitemap.xml /
#  OGP にそのまま焼き込まれる（ビルドログに警告は出る）。
NEXT_PUBLIC_SITE_URL=

# --- ビルド時とランタイムの両方で要る ---

# R2 の公開ベースURL。例: https://xxxx.r2.dev または独自ドメイン
#   ビルド時   next.config.ts が remotePatterns と CSP の img-src を組み立てる
#   ランタイム lib/r2.ts が公開URLの生成と、削除可否の判定に使う
R2_PUBLIC_BASE_URL=

# --- ランタイムだけで要る（絶対にブラウザへ出さない）---

# Supabase の全権キー。API Route 内でのみ使う
SUPABASE_SERVICE_ROLE_KEY=

# R2（S3互換API）
# 例: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- 移行スクリプト（scripts/）を動かす時だけ ---
WP_BASE_URL=
WP_DB_HOST=
WP_DB_NAME=
WP_DB_USER=
WP_DB_PASSWORD=
