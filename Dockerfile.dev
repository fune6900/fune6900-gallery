# ============================================
# 開発用 Dockerfile
# ホットリロードで開発するための軽量な構成
# ============================================
FROM node:22-bookworm-slim

WORKDIR /app

# 先にpackage.jsonだけコピーして依存インストール（キャッシュを効かせる）
COPY package.json package-lock.json* ./
RUN npm install

# ソースをコピー（実際の開発ではvolumeマウントで上書きされる）
COPY . .

EXPOSE 3000

# 開発サーバー起動（ホットリロード有効）
CMD ["npm", "run", "dev"]
